    <string name="app_name">LingoTrail</string>
    <string name="app_tagline">Point. Read. Go.</string>

    <!-- Onboarding -->
    <string name="onboarding_headline">Read any sign,\nanywhere.</string>
    <string name="onboarding_subheadline">Photograph a menu, a sign or a notice. LingoTrail recognises the text, translates it, and lays the translation right back over the original.</string>
    <string name="onboarding_feature_capture_title">Snap or import</string>
    <string name="onboarding_feature_capture_text">Camera or gallery — any photo with text works.</string>
    <string name="onboarding_feature_overlay_title">Translation in place</string>
    <string name="onboarding_feature_overlay_text">The translation covers the original, matched to its size and position.</string>
    <string name="onboarding_feature_history_title">Your journey, kept</string>
    <string name="onboarding_feature_history_text">Every scan stays in history — zoomable, with the overlay one tap away.</string>
