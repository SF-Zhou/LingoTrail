    <!-- Privacy -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">LingoTrail has no accounts and no analytics.\n\nYour photos stay on this device, except when a scan is translated: then the photo is sent to the DeepSeek API you configured. Your API key is stored only in this app’s private storage.\n\nClearing history deletes every photo and translation on this device.</string>

