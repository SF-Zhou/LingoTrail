# EditorConfig for LingoTrail — https://editorconfig.org
# Android Studio / IntelliJ IDEA, VS Code and most editors respect this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin: official code style, 4-space indents, trailing commas encouraged.
[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_code_style_defaults = KODEX_OFFICIAL
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Markup, configuration and shell scripts use 2 spaces.
[*.{xml,yml,yaml,json,jsonc,sh,bash}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.properties]
indent_size = 4

[Makefile]
indent_style = tab
